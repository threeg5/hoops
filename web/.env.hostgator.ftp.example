# Local HostGator FTP deploy (explicit FTPS, port 21).
# Copy to .env.hostgator.ftp (gitignored) and set HOSTGATOR_FTP_PASS.
# Never commit .env.hostgator.ftp or put the password in git.
#
#   copy .env.hostgator.ftp.example .env.hostgator.ftp
#   (then edit HOSTGATOR_FTP_PASS)
#
# Deploy:
#   npm run build:hostgator
#   python deploy-hostgator.py

HOSTGATOR_FTP_HOST=ftp.mobilewordmarketing.com
HOSTGATOR_FTP_USER=Cursor@website-c7b1cc7d.mobilewordmarketing.com
HOSTGATOR_FTP_PASS=
HOSTGATOR_FTP_PORT=21

# Live site folder. If this FTP user is already chrooted there, use .
HOSTGATOR_FTP_REMOTE_DIR=public_html/website_c7b1cc7d/hoops
